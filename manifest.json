{
  "manifest_version": 2,
  "name": "Моё расширение",
  "version": "1.0.0",
  "description": "Краткое описание вашего расширения",
  
  "permissions": [
    "activeTab",
    "storage",
    "https://api.example.com/*"
  ],
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Моё расширение",
    "default_icon": "icon.svg"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ],
  
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}